# Supabase — public keys, safe to expose in the browser bundle.
# Row Level Security is what protects your data, not the secrecy of these.
# Find them in: Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY_HERE

# NEVER put the service_role key in a NEXT_PUBLIC_ variable, and never
# commit it. It bypasses Row Level Security entirely.
