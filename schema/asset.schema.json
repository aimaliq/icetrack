{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://icetrack.dev/schema/asset.schema.json",
  "title": "IceTrack Asset",
  "description": "A single luxury asset linked to a public figure. Every claim must be traceable to a public source.",
  "type": "object",
  "required": [
    "id",
    "ownerId",
    "category",
    "name",
    "status",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Unique slug, e.g. 'drake-boeing-767'."
    },
    "ownerId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Slug of the celebrity in data/celebrities."
    },
    "category": {
      "type": "string",
      "enum": [
        "jet",
        "car",
        "watch",
        "yacht",
        "estate",
        "jewelry"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "make": {
      "type": "string",
      "maxLength": 80
    },
    "model": {
      "type": "string",
      "maxLength": 80
    },
    "year": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 2100
    },
    "registration": {
      "type": "string",
      "maxLength": 40,
      "description": "Public registry identifier only (e.g. aircraft tail number). Never a VIN or private document number."
    },
    "estimatedValueUsd": {
      "type": "integer",
      "minimum": 0,
      "description": "Press-reported estimate. Not an appraisal."
    },
    "acquiredYear": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 2100
    },
    "status": {
      "type": "string",
      "enum": [
        "verified",
        "reported",
        "unverified",
        "former",
        "disputed"
      ],
      "description": "verified = confirmed in a public registry or primary source. reported = credible press only. unverified = needs sourcing, not shown publicly. former = previously owned, since sold. disputed = conflicting sources or subject contests it."
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "region": {
      "type": "string",
      "maxLength": 80,
      "description": "Country or state at most. Precise addresses, moorings and hangar locations are never stored."
    },
    "summary": {
      "type": "string",
      "maxLength": 600
    },
    "imageUrl": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "description": "At least one public source per asset. Entries with a TODO url stay 'unverified'.",
      "items": {
        "type": "object",
        "required": [
          "title",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          },
          "url": {
            "type": "string",
            "minLength": 4
          },
          "publisher": {
            "type": "string",
            "maxLength": 120
          },
          "retrieved": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "updatedAt": {
      "type": "string",
      "format": "date"
    },
    "imageCredit": {
      "type": "object",
      "description": "Attribution for the image. Required by CC BY-SA and similar licences.",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "author": {
          "type": "string",
          "maxLength": 200
        },
        "license": {
          "type": "string",
          "maxLength": 120
        },
        "sourcePage": {
          "type": "string"
        }
      }
    }
  }
}
